  "created_at": "2026-08-23",
  "city_id": "CITY_ASTERLINE_01",
  "source_frame": {
    "name": "ASTERLINE_LOCAL_METRIC_V1",
    "vector_component_order": [
      "east_m",
      "north_m",
      "up_m"
    ],
    "units": "meters",
    "axes": {
      "x": "east",
      "y": "north",
      "z": "up"
    },
    "persistence": "ABSOLUTE_SOURCE_COORDINATES_REMAIN_AUTHORITATIVE"
  },
  "godot_frame": {
    "name": "GODOT_LOCAL_REBASED_V1",
    "vector_component_order": [
      "right_east_m",
      "up_m",
      "back_south_m"
    ],
    "units": "meters",
    "axes": {
      "x": "east / Vector3.RIGHT",
      "y": "up / Vector3.UP",
      "negative_z": "north / Vector3.FORWARD"
    },
    "persistence": "TRANSIENT_RUNTIME_COORDINATES_ONLY"
  },
  "linear_transform": {
    "source_delta_enu_to_godot_local_xyz_matrix": [
      [
        1,
        0,
        0
      ],
      [
        0,
        0,
        1
      ],
      [
        0,
        -1,
        0
      ]
    ],
    "formula": "godot_local = [east-east0, up-up0, -(north-north0)]",
    "inverse_formula": "source_enu = [east0+godot_x, north0-godot_z, up0+godot_y]",
    "determinant": 1,
    "handedness": "RIGHT_HANDED_PRESERVED",
    "uniform_scale": 1,
    "distance_and_angle_preserving": true,
    "source_polygon_vertex_order_preserved_for_upward_normals": true
  },
  "origin_shifting": {
    "strategy": "HORIZONTAL_100M_CELL_ANCHOR",
    "required_for_future_runtime": true,
    "runtime_orchestration_implemented": false,
    "large_world_double_precision_build_required": false,
    "cell_size_m": 100,
    "rebase_threshold_horizontal_m": 1600,
    "threshold_basis": "REVERSIBLE_CONSERVATIVE_CHOICE_BELOW_GODOT_4_7_FIRST_PERSON_2048M_RECOMMENDED_LOWER_BOUND",
    "source_cell_formula": "[floori(east/100), floori(north/100)]",
    "cell_anchor_source_enu_formula": "[cell_east*100, cell_north*100, 0]",
    "negative_coordinate_rule": "MATHEMATICAL_FLOOR_NOT_TRUNCATION_TOWARD_ZERO",
    "rebase_frame": "PHYSICS_FRAME_BOUNDARY_ONLY",
    "rebase_transaction": [
      "Select the new 100m source cell from the authoritative player source position.",
      "Compute the old-anchor to new-anchor Godot-local delta.",
      "Move every loaded world root and participating physics body by the same delta in one transaction.",
      "Preserve source coordinates, stable IDs, velocities, rotations, parent-child relations and runtime bindings.",
      "Rebuild or shift navigation/physics caches only through their future verified subsystem contracts.",
      "Publish the new anchor only after every participating subsystem acknowledges the same transaction."
    ],
    "networking_rule": "NETWORK_ABSOLUTE_SOURCE_COORDINATES_AND_ANCHOR_ID; NEVER SEND UNLABELED CLIENT_LOCAL_COORDINATES",
    "save_rule": "SAVE ABSOLUTE SOURCE COORDINATES PLUS STABLE OWNER IDS; NEVER SAVE REBASED LOCAL POSITION AS WORLD TRUTH"
  },
