{
  "schema_version": "1.0.0",
  "checklist_id": "CHECKLIST_RUNTIME_V1",
  "before_narration": [
    "load authoritative pointer",
    "verify save and event hashes",
    "read latest handoff",
    "confirm current time/location/characters",
    "confirm no unresolved critical conflict"
  ],
  "after_user_action": [
    "classify input",
    "resolve action",
    "write event",
    "update projections",
    "advance time",
    "run off-screen consequences",
    "validate",
    "seal save when required",
    "write handoff"
  ]
}
