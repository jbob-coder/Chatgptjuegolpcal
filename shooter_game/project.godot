"deadzone": 0.2,
"events": []
}
move_back={
"deadzone": 0.2,
"events": []
}
jump={
"deadzone": 0.2,
"events": []
}
aim={
"deadzone": 0.2,
"events": []
}
fire={
"deadzone": 0.2,
"events": []
}
reload={
"deadzone": 0.2,
"events": []
}
dodge={
"deadzone": 0.2,
"events": []
}
interact={
"deadzone": 0.2,
"events": []
}
pause_game={
"deadzone": 0.2,
"events": []
}

[rendering]
